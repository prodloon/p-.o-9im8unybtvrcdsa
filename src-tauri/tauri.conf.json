{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daisy Cluster",
  "version": "0.0.1",
  "identifier": "com.moses.daisycluster",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "windows": [
      {
        "title": "Daisy Cluster \u2014 Telemetry",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QjI1QTE4RTNEMjJBNkQKUldSdEt0TGpHRnF5RmNaaXJCZ0xXNHlKTC9MS2l4NFg2RzhyNnFaZ2ZGK3NwUU95ZGFVUm0xR2gK",
      "endpoints": [
        "https://github.com/prodloon/daisy-chain/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}